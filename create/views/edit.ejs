<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        *{
            background-color: rgb(15, 15, 15);
            color: white;
        }
        .form{
            margin: 10px;
        }
        .title{
            display: block;
            margin: 10px;
            width: 30vw;
            background-color: rgb(40, 39, 39);
            outline: none;
            border: none;
            padding: 10px;
        }
        .submit{
            margin-top: 10px;
            padding: 10px 20px;
            background-color: blue;
            border: none;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <a href="/">Go to the Home</a>
    <div class="form">
            <form action="/edit" method="post">
                <input type="text" placeholder="Write your title..." class="title" name="oldname"  value="<%=filename%>" readonly>
                <input type="text" placeholder="Write your title..." class="title" name="newname">
                <input type="submit" value="Done" class="submit">
            </form>
    </div>
    
</body>
</html>