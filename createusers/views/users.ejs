    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Create Users</title>
        <link rel="stylesheet" href="/stylesheets/Users.css">
    </head>
    <body>
    <div class="nav">
        <a href="/">Home</a>
    </div>
    <div class="container">

        <% createduser.forEach(function(user) { %>

            <div class="user">
                <img src="<%= user.image %>" alt="image">

                <h3><%= user.name %></h3>

                <p><%= user.email %></p>

                <div class="btns">
                    <a href="/edit/<%=user._id%>">Edit User</a>
                    <a href="/delete/<%=user.name%>">Delete User</a>
                </div>
            </div>

        <% }) %>
    </div>


        
        
    </body>
    </html>