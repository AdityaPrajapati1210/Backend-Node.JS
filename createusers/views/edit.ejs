<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        *{
            margin: 0;
            padding: 0;
            background-color: black;
            box-sizing: border-box;
        }

        input{
            background: #3a3535;
            padding: 10px;
            margin-top: 10px;
            margin-left: 20px;
            border-radius: 12px;
            border: none;
            outline: none;
            color: white    ;
        }
        .submit{
            background: blue;
        }
    </style>
</head>
<body>
    <div class="container">
    <form action="/update/<%=user._id%>" method="post">
        <div>
            <input type="text" class="name" placeholder="name" value="<%=user.name%>" >
            <input type="text" class="name" placeholder="name" name="name">

        </div>
        <div>
            <input type="text" class="name" placeholder="email" value="<%=user.email%>">
            <input type="text" class="name" placeholder="email" name="email">

        </div>
        <div>
            <input type="text" class="name" placeholder="image url" value="<%=user.image%>">
            <input type="text" class="name" placeholder="image url" name="image">

        </div>
        <input type="submit" value="Update" class="submit">
        
    </form>
</div>
    
</body>
</html>