<%- include("header") %>

<h1>Gallery Page</h1>

<h2>Categories</h2>

<a href="/gallery">all</a>

<% categories.forEach(category => { %>

    <a href="/gallery?category=<%= category %>">
        <%= category %>
    </a>

<% }) %>


<hr>

<h2><%= selectedCategory || "Select a Category" %></h2>

<% images.forEach(image => { %>

    <img src="<%= image.image_url %>" width="250">

    <p><%= image.description %></p>

<% }) %>]



