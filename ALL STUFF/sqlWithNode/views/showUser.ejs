<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show User</title>
    <link rel="stylesheet" href="/css/tailwind.css">
</head>

<body class="bg-gray-400 p-5">
    <a href="/newUser" class="bg-red-400 text-white outline-1 outline-white px-2 rounded-2xl text-xl font-bold m-3 inline-block">New User</a>

    <div class="flex gap-4 flex-wrap">

        <% for(let users of data) { %>

            <div class=" relative min-h-[120px] w-[280px] max-h-[150px] bg-amber-300 rounded-3xl shadow-lg p-2">

                <h1 class="font-bold">
                    @<%= users.name %>
                </h1>

                <p class="text-sm">
                    Email: <%= users.email %>
                </p>

                <p class="font-extralight text-sm">
                    Id: <%= users.id %>
                </p>
                <a href="/user/<%=users.id%>" class="bg-gray-900 text-white outline-1 outline-white px-2 rounded-2xl text-xs mt-2 inline-block absolute bottom-3 left-3">Edit username</a>
                <a href="/user/delete/<%=users.id%>" class="bg-red-900 text-white outline-1 outline-white px-2 rounded-2xl text-xs mt-2 inline-block absolute bottom-3 right-3">Delete</a>
                
            </div>

        <% } %>

    </div>
<script>
    <% if (deleted) { %>
        alert("Account deleted!!");
    <% } %>
</script>
</body>
</html>