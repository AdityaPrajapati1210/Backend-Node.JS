<%- include("../navbar") %><form
    action="/listing/<%= data._id %>?_method=PATCH"
    method="POST"
    class="mx-auto mt-10 max-w-2xl rounded-2xl bg-white p-8 shadow-lg"
>
    <h1 class="mb-6 text-3xl font-bold text-gray-800">
        Edit Listing
    </h1>

    <!-- Title -->
    <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-gray-700">
            Title
        </label>

        <input
            type="text"
            name="title"
            value="<%= data.title %>"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
            required
        >
    </div>

    <!-- Description -->
    <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-gray-700">
            Description
        </label>

        <textarea
            name="description"
            rows="4"
            class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
            required
        ><%= data.description %></textarea>
    </div>

    <!-- Location & Country -->
    <div class="mb-5 grid grid-cols-1 gap-5 sm:grid-cols-2">

        <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700">
                Location
            </label>

            <input
                type="text"
                name="location"
                value="<%= data.location %>"
                class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                required
            >
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700">
                Country
            </label>

            <input
                type="text"
                name="country"
                value="<%= data.country %>"
                class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                required
            >
        </div>

    </div>

    <!-- Price -->
    <div class="mb-5">
        <label class="mb-2 block text-sm font-semibold text-gray-700">
            Price
        </label>

        <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500">
                ₹
            </span>

            <input
                type="number"
                name="price"
                value="<%= data.price %>"
                class="w-full rounded-lg border border-gray-300 py-3 pl-9 pr-4 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                required
            >
        </div>
    </div>

    <!-- Image URL -->
    <div class="mb-7">
        <label class="mb-2 block text-sm font-semibold text-gray-700">
            Image URL
        </label>

        <input
            type="text"
            name="image_url"
            value="<%= data.image_url %>"
            class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
            required
        >
    </div>

    <!-- Buttons -->
    <div class="flex justify-end gap-3">

        <a
            href="/listing/<%= data._id %>"
            class="rounded-lg bg-gray-200 px-5 py-3 font-semibold text-gray-700 transition hover:bg-gray-300"
        >
            Cancel
        </a>

        <button
            type="submit"
            class="rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white transition hover:bg-blue-700 active:scale-95"
        >
            Update Listing
        </button>

    </div>

</form>