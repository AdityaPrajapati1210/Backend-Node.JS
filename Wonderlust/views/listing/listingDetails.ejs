<% layout('boilerplate') %>

    <div class="min-h-screen bg-gray-50 px-4 py-8 sm:px-6 lg:px-8">

        <div class="mx-auto max-w-5xl">

            <!-- Back / Header -->
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">
                        Explore Stay
                    </p>
                    <h1 class="mt-1 text-2xl font-bold text-gray-900 sm:text-3xl">
                        <%= data.title %>
                    </h1>
                </div>

                <a href="/home"
                    class="rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-100">
                    ← Back
                </a>
            </div>


            <!-- Main Card -->
            <div class="overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-gray-200">

                <!-- Image -->
                <div class="relative h-[300px] w-full overflow-hidden sm:h-[450px]">

                    <img src="<%= data.image_url %>" alt="<%= data.title %>"
                        class="h-full w-full object-cover transition duration-500 hover:scale-105">

                    <!-- Image Badge -->
                    <div
                        class="absolute left-5 top-5 rounded-full bg-white/90 px-4 py-2 text-sm font-semibold text-gray-800 shadow backdrop-blur">
                        ⭐ Featured Stay
                    </div>

                </div>


                <!-- Details -->
                <div class="p-6 sm:p-8">

                    <!-- Title + Location -->
                    <div
                        class="flex flex-col gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-start sm:justify-between">

                        <div>
                            <h2 class="text-3xl font-bold text-gray-900">
                                <%= data.title %>
                            </h2>

                            <p class="mt-2 flex items-center gap-2 text-gray-500">
                                📍 <%= data.location %>, <%= data.country %>
                            </p>
                        </div>

                        <!-- Price -->
                        <div class="rounded-2xl bg-gray-50 px-5 py-4 text-left sm:text-right">
                            <p class="text-sm text-gray-500">
                                Price
                            </p>

                            <p class="text-2xl font-bold text-gray-900">
                                ₹<%= data.price %>
                            </p>

                            <p class="text-sm text-gray-500">
                                per night
                            </p>
                        </div>

                    </div>


                    <!-- Description -->
                    <div class="mt-7">
                        <h3 class="text-xl font-bold text-gray-900">
                            About this place
                        </h3>

                        <p class="mt-3 max-w-3xl leading-7 text-gray-600">
                            <%= data.description %>
                        </p>
                    </div>


                    <!-- Information -->
                    <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-3">

                        <div class="rounded-2xl bg-gray-50 p-5 ring-1 ring-gray-200">
                            <p class="text-sm text-gray-500">
                                📍 Location
                            </p>

                            <p class="mt-2 font-semibold text-gray-900">
                                <%= data.location %>
                            </p>
                        </div>


                        <div class="rounded-2xl bg-gray-50 p-5 ring-1 ring-gray-200">
                            <p class="text-sm text-gray-500">
                                🌎 Country
                            </p>

                            <p class="mt-2 font-semibold text-gray-900">
                                <%= data.country %>
                            </p>
                        </div>


                        <div class="rounded-2xl bg-gray-50 p-5 ring-1 ring-gray-200">
                            <p class="text-sm text-gray-500">
                                💰 Price
                            </p>

                            <p class="mt-2 font-semibold text-gray-900">
                                ₹<%= data.price %> / night
                            </p>
                        </div>

                    </div>


                    <!-- Reviews -->
                    <div class="mt-10 border-t border-gray-200 pt-8">

                        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                            <div>
                                <h3 class="text-2xl font-bold text-gray-900">
                                    Reviews
                                </h3>

                                <p class="mt-1 text-sm text-gray-500">
                                    What guests are saying
                                </p>
                            </div>

                            <button onclick="addreview()"
                                class="rounded-full bg-black px-6 py-3 font-semibold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-gray-800 hover:shadow-lg ">
                                + Add Review
                            </button>

                        </div>

                        <!-- yaha pe review add hoga class hidden rahega... -->
                        <!-- Add Review Form -->

                        <div id="reviewForm"
                            class="mt-6 hidden rounded-2xl border border-gray-200 bg-gray-50 p-6 shadow-sm">

                            <div class="mb-5">
                                <h4 class="text-xl font-bold text-gray-900">
                                    Write a Review
                                </h4>

                                <p class="mt-1 text-sm text-gray-500">
                                    Share your experience with other guests.
                                </p>
                            </div>


                            <form id="reviewFormSubmit" action="/listing/<%= data._id %>/review" method="POST">

                                <!-- Rating -->
                                <div class="mb-5">
                                    <span>Rating: </span>

                                    <input type="radio" name="rating" value="1" required>
                                    <label>1 ⭐</label>

                                    <input type="radio" name="rating" value="2">
                                    <label>2 ⭐</label>

                                    <input type="radio" name="rating" value="3">
                                    <label>3 ⭐</label>

                                    <input type="radio" name="rating" value="4">
                                    <label>4 ⭐</label>

                                    <input type="radio" name="rating" value="5">
                                    <label>5 ⭐</label>
                                </div>


                                <!-- Comment -->
                                <div class="mb-5">
                                    <label for="comment" class="mb-2 block text-sm font-semibold text-gray-700">
                                        Your Review
                                    </label>

                                    <textarea id="comment" name="comment" rows="4" required
                                        placeholder="Write your experience here..."
                                        class="w-full resize-none rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-700 outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-2 focus:ring-gray-200"></textarea>
                                </div>


                                <!-- Buttons -->
                                <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">

                                    <button type="button" onclick="cancelReview()"
                                        class="rounded-xl border border-gray-300 bg-white px-6 py-3 font-semibold text-gray-700 transition hover:bg-gray-100">
                                        Cancel
                                    </button>

                                    <button type="submit"
                                        class="rounded-xl bg-black px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-gray-800">
                                        Submit Review
                                    </button>

                                </div>

                            </form>

                        </div>



                        <!-- Review Cards -->
                        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 " id="reviewContainer">
                            <%if(data.review.length === 0){%>
                            <p id="noReviews" class=" text-gray-500">
                                No reviews yet... Give your first review.

                            </p>
                            <%}%>



                            <%data.review.forEach((review)=> { %>
                                <div
                                    class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md">

                                    <div>
                                        <span
                                            class="rounded-full bg-yellow-50 px-3 py-1 text-sm font-semibold text-yellow-700">
                                            ⭐ <%=review.rating%>
                                        </span>
                                    </div>

                                    <p class="mt-4 leading-6 text-gray-600">
                                        <%=review.comment%>
                                    </p>

                                    <form action="/listing/<%=data._id%>/review/<%=review._id%>?_method=DELETE"
                                        method="Post">
                                        <button type="submit"
                                            class="w-full rounded px-6 py-2 font-semibold text-black border-2 border-red-700 shadow-sm transition hover:bg-red-600 hover:shadow-md sm:w-auto relative right-1.5">Remove</button>
                                    </form>

                                </div>

                                <%})%>




                        </div>

                    </div>


                    <!-- Action Buttons -->
                    <div class="mt-10 flex flex-col gap-3 border-t border-gray-200 pt-6 sm:flex-row sm:justify-end">

                        <a href="/listing/<%= data._id %>/edit"
                            class="rounded-xl bg-blue-600 px-6 py-3 text-center font-semibold text-white shadow-sm transition hover:bg-blue-700 hover:shadow-md">
                            Edit Listing
                        </a>

                        <form action="/listing/<%= data._id %>?_method=DELETE" method="POST">

                            <button type="submit"
                                class="w-full rounded-xl bg-red-500 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-red-600 hover:shadow-md sm:w-auto">
                                Delete Listing
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>
    