<% layout('boilerplate') %>

<div class="flex justify-center items-center">
    <div class="p-2 v flex flex-col">
        <h1 class="mx-auto">Login</h1>
        <form action="/user/login" method="post">
            <label for="username">username</label>
            <input type="text" name="username" id="username" class="border-2 border-black">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" class="border-2 border-black">
            <button type="submit" class="p-1 bg-blue-500 rounded">Login</button>
        </form>
    </div>
</div>